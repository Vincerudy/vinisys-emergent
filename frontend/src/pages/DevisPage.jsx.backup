    form.resetFields();
    setProducts([{ productName: '', quantity: 1, price: 0, tva: tvas.length > 0 ? tvas[0].value : null }]);  ////////////////////////////////////////////////////////////
    setModalVisible(true);                                                                                    // Si tva activé, on utilise la tva par defaut sinon rin 
  };
 
// Bouton OK de la modale
const handleModalOk = async () => {
  try {
    if (isEditingFacture) {
      // Validation du formulaire pour obtenir les champs de la facture (comme le client, la date, etc.)
      const values = await form.validateFields();
      // Calcul du montant total des produits
      const totalAmount = products.reduce((acc, product) => acc + (product.quantity * product.price), 0);
      // Conversion de la date en format correct pour la base de données (format 'YYYY-MM-DD')
      const formattedDate = dayjs(values.date).format('YYYY-MM-DD'); // Vous pouvez ajuster le format selon vos besoins

      // Création de l'objet facture avec les détails
      const oFacture = {
        id: editingInvoice.id,
        ...values, // Récupération des champs de la facture (ex : client, date, etc.)
        date: formattedDate, // Utilisez la date formatée ici
        products, // Ajout des produits avec leurs détails
        totalAmount, // Ajout du montant total
        totalHT,
        totalTTC,
        totalTVA,
        totalTPS, // Ajout du montant TPS
        taxe_secondaire: useTaxeSecondaire && taxeSecondaire ? taxeSecondaire.value : null, // Taux de la taxe secondaire
        total_taxe_secondaire: useTaxeSecondaire ? totalTPS : 0, // Montant de la taxe secondaire
        societe_id
        
      };
      console.log('oFacture total', oFacture)
      // Logique supplémentaire ici, par exemple, envoyer oFacture à une API
      const response = await axios.post(`${import.meta.env.VITE_API_URL}/factures/modifier/${oFacture.id}`, oFacture);
      setIsEditingFacture(false);
      setModalVisible(false);
      obtenirFactures();
    } else {
      // Validation du formulaire pour obtenir les champs de la facture (comme le client, la date, etc.)
      const values = await form.validateFields();
      // Calcul du montant total des produits
      const totalAmount = products.reduce((acc, product) => acc + (product.quantity * product.price), 0);

      // Conversion de la date en format correct pour la base de données (format 'YYYY-MM-DD')
      const formattedDate = dayjs(values.date).format('YYYY-MM-DD'); // Vous pouvez ajuster le format selon vos besoins

      // Création de l'objet facture avec les détails
      const oFacture = {
        ...values, // Récupération des champs de la facture (ex : client, date, etc.)
        date: formattedDate, // Utilisez la date formatée ici
        products, // Ajout des produits avec leurs détails
        totalAmount, // Ajout du montant total
        type: isInvoice ? 'FACT' : 'DEVI',
        totalHT,
        totalTTC,
        totalTVA,
        totalTPS, // Ajout du montant TPS
        taxe_secondaire: useTaxeSecondaire && taxeSecondaire ? taxeSecondaire.value : null, // Taux de la taxe secondaire
        total_taxe_secondaire: useTaxeSecondaire ? totalTPS : 0, // Montant de la taxe secondaire
        numero: numeroFacture,
        societe_id, 
        id
      };
 
      console.log('oFacture ', oFacture);
      // Logique supplémentaire ici, par exemple, envoyer oFacture à une API
      const response = await axios.post(`${import.meta.env.VITE_API_URL}/factures`, oFacture);
      setModalVisible(false);
      obtenirFactures();
    }
  } catch (error) {
    console.error('Erreur dans la validation du formulaire ou l\'envoi de la facture:', error);
  }
  fetchDataFactures(id);
};

  //Modification d'un client
  const handleEditClient = async (record) => {
    setEditingClient(record);
    clientForm.setFieldsValue(record);
 
    setIsEditingClient(true)
  };
  const handleEditClientRead = async (record) => {
    setEditingClient(record);
    clientForm.setFieldsValue(record);
    setIsEditingClient(true)
  };

  const handleEditInvoice = (record, type) => {
    console.log('TTC HT ',record)
    form.setFieldsValue({ entryMode: record.type_saisie || 'TTC' });
    setEntryMode(record.type_saisie)

    // Vérifier si le devis avait une taxe secondaire
    if (record.taxe_secondaire && record.total_taxe_secondaire) {
      setUseTaxeSecondaire(true);
      setEditingTaxeSecondaire({
        value: record.taxe_secondaire,
        total: record.total_taxe_secondaire
      });
    } else {
      setUseTaxeSecondaire(false);
      setEditingTaxeSecondaire(null);
    }
 
    if(record.statut === 'payée'){
      Modal.info({
        title: 'Informations',
        content: (
          <div>
            <p>La facture n° {record.invoiceNumber} est marquée comme payée, vous ne pouvez plus la modifier</p>
            {/* Ajoute ici d'autres informations que tu souhaites afficher */}
          </div>
        ),
        okText: 'OK', // Bouton unique pour fermer la modal
        onOk: () => {
          console.log('Modal fermée'); // Logique à exécuter lors de la fermeture
        },
      });
    }
    else{
      if(type == 'INVO'){
        setIsInvoicee(true)
      }
      else{
        setIsInvoicee(false)
      }
      setIsEditingFacture(true)  // on informe qu'on met à jour un client
      const oProduits = record.produits.map(product => ({
        productName: product.nom,
        quantity: product.quantite,
        price: parseFloat(product.prix), // Convertir le prix en nombre
        tva: parseFloat(product.tva) + '%'
      }));
      setEditingInvoice(record); // Stocke la facture en cours d'édition
      setProducts(oProduits || [{ productName: '', quantity: 2, price: 0 }]); // Pré-remplir les produits si existants
      console.log(" oProduits oProduits", oProduits)
      form.setFieldsValue({
        
        client: record.client_id,
        invoiceNumber: record.invoiceNumber,
        date:  dayjs(record.date, 'DD/MM/YYYY') ,
        // Ajoutez d'autres champs selon votre besoin, par exemple:
        totalAmount: record.totalAmount,
        // Etc.
      });
      setModalVisible(true); // Ouvre la modal
    }
  };

  // Votre fonction modifiée
  const HandleDeleteFacture = async (record) => {
    if(record.statut === 'payée'){
      Modal.info({
        title: 'Informations',
        content: (
          <div>
            <p>La facture n° {record.invoiceNumber} est marquée comme payée, vous ne pouvez plus la supprimer</p>
            {/* Ajoute ici d'autres informations que tu souhaites afficher */}
          </div>
        ),
        okText: 'OK', // Bouton unique pour fermer la modal
        onOk: () => {
          console.log('Modal fermée'); // Logique à exécuter lors de la fermeture
        },
      });
    }
    else{
      Modal.confirm({
        title: 'Confirmer la suppression',
        content: `Êtes-vous sûr de vouloir supprimer cette facture  ?`,
        okText: 'Confirmer',
        okType: 'danger',
        cancelText: 'Annuler',
        okButtonProps: {
            className: 'custom-button', // Classe pour le bouton "Oui"
        },
        cancelButtonProps: {
            className: 'custom-button', // Classe pour le bouton "Non"
        },
          onOk: async () => {
              try {
    
                  const response = await axios.post(`${import.meta.env.VITE_API_URL}/factures/supprimer/${record.id}/${societe_id}`);
   
                  obtenirFactures();
                  return response.data; // Retourne les données de réponse pour un éventuel traitement ultérieur
              } catch (error) {
                  console.error('Erreur lors de la suppression de la facture:', error.response ? error.response.data : error.message);
                  throw error; // Lance l'erreur pour un éventuel traitement ultérieur
              }
          },
          onCancel() {
              console.log('Suppression annulée');
          },
      });
    }
  };

  function cleanNumber(value) {
    const number = parseFloat(value);
    return isNaN(number) ? 0 : number % 1 === 0 ? number.toFixed(0) : number.toString();
  }
  

  const calculateTotals = () => {
    let totalHT = 0;
    let totalTTC = 0;
    let totalTVA = 0;
    let totalTPS = 0; // Nouvelle variable pour la taxe secondaire
    let totalTVAByRate = {}; // Clé : taux de TVA, Valeur : montant de la TVA
    
    // Trouver la taxe secondaire active ou utiliser celle du devis en cours d'édition
    let taxeSecondaire = null;
    let tauxTPS = 0;
    
    if (isEditingFacture && useTaxeSecondaire && editingTaxeSecondaire) {
      // En mode édition avec taxe secondaire activée, utiliser la taxe du devis
      const taxeSecondarieActive = tvas.find(tva => parseFloat(tva.value) === parseFloat(editingTaxeSecondaire.value));
      if (taxeSecondarieActive) {
        taxeSecondaire = taxeSecondarieActive;
        tauxTPS = parseFloat(taxeSecondarieActive.value);
      }
    } else if (useTaxeSecondaire) {
      // En mode création ou édition avec taxe secondaire activée, utiliser la taxe active
      taxeSecondaire = tvas.find(tva => tva.taxe_secondaire === 'OUI');
      tauxTPS = taxeSecondaire ? parseFloat(taxeSecondaire.value) : 0;
    }
    
    console.log('products test ', products)
    products.forEach((product) => {
      const quantity = parseFloat(product.quantity) || 0;
      const price = parseFloat(product.price) || 0;
      const tvaRate = parseFloat(product.tva) || 0;
  
      const lineTotal = quantity * price;
  
      if (entryMode === 'TTC') {
        const ht = lineTotal / (1 + tvaRate / 100);
        const tva = lineTotal - ht;
  
        totalHT += ht;
        totalTTC += lineTotal;
  
        totalTVAByRate[tvaRate] = (totalTVAByRate[tvaRate] || 0) + tva;
        totalTVA += tva;
      } else {
        const tva = lineTotal * (tvaRate / 100);
        const ttc = lineTotal + tva;
  
        totalHT += lineTotal;
        totalTTC += ttc;
  
        totalTVAByRate[tvaRate] = (totalTVAByRate[tvaRate] || 0) + tva;
        totalTVA += tva;
      }
    });
    
    // Calculer TPS sur le montant HT si une taxe secondaire est active
    if (tauxTPS > 0) {
      totalTPS = totalHT * (tauxTPS / 100);
      totalTTC += totalTPS; // Ajouter TPS au total TTC
    }
  
    // Optionnel : arrondir les valeurs
    totalHT = parseFloat(totalHT.toFixed(2));
    totalTTC = parseFloat(totalTTC.toFixed(2));
    totalTVA = parseFloat(totalTVA.toFixed(2));
    totalTPS = parseFloat(totalTPS.toFixed(2));
    Object.keys(totalTVAByRate).forEach(rate => {
      totalTVAByRate[rate] = parseFloat(totalTVAByRate[rate].toFixed(2));
    });
  
    return {
      totalHT,
      totalTTC,
      totalTVAByRate,
      totalTVA,
      totalTPS, // Nouvelle valeur retournée
      taxeSecondaire, // Informations sur la taxe secondaire
    };
  };
  

  const { totalHT, totalTTC, totalTVAByRate, totalTVA, totalTPS, taxeSecondaire } = calculateTotals();
  

  const handleModalCancel = () => {
    setModalVisible(false);
  };

 
  const handleRemoveProduct = (index) => {
    const newProducts = products.filter((_, i) => i !== index);
    setProducts(newProducts);
  };


  const handleModalModeleFactureCancel = (value, type) => {
    if(type == 'FACT'){
      setIsInvoicee(true)
    }
    else{
      setIsInvoicee(false)
    }
    setFactures(value)
    setModalFactureVisible(!modalFactureVisible);
  };

  const handleModeleFactureImpression = () => {
    const element = factureRef.current; // Récupère l'élément référencé
 

    if (!element) {
        console.error("Element non trouvé !");
        return;
    }

    // Appliquer les styles CSS pour éviter les ruptures de lignes et gérer la marge
    const style = document.createElement('style');
    style.innerHTML = `
        .invoice-table tbody tr {
            page-break-inside: avoid; /* Évite la coupure des lignes dans le tableau */
        }
        .invoice-table td {
            word-wrap: break-word; /* Permet aux mots longs de se couper */
        }
        .invoice-table {
            margin-top: 20px; /* Ajoute 20px de marge au tableau */
        }
        .page-break {
            margin-top: 20px; /* Ajoute 20px de marge en haut pour la seconde page */
        }
    `;
    document.head.appendChild(style);

    // Ajout de la classe pour la seconde page
    const rows = element.querySelectorAll('.invoice-table tbody tr');
    rows.forEach((row) => {
        // Ajoutez une classe pour gérer l'espacement des lignes si nécessaire
        row.classList.add('page-break');
    });

    const options = {
        margin: [10, 0, 0, 10], // Marges à zéro pour le reste
        filename: `facture-${Date.now()}.pdf`,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
    };

    // Utilisation de html2pdf pour générer le PDF
    html2pdf()
        .from(element)
        .set(options)
        .save()
        .then(() => {
        })
        .catch((error) => {
            console.error("Erreur lors de la création du PDF :", error);
        });
};

  const quoteColumns = [
    { 
      title: 'Statut', 
      dataIndex: 'statut', 
      key: 'statut',
      render: (text) => {
        let backgroundColor = 'transparent';
        let color = 'inherit';
  
        if (text === 'accepté') {
          backgroundColor = '#b4f8c4'; // Vert clair
          color = '#155724'; // Vert foncé
        } else if (text === 'en attente') {
          backgroundColor = '#cce5ff'; // Bleu clair
          color = '#004085'; // Bleu foncé
        }
        else if (text === 'En retard'){
          backgroundColor = '#f9c3c3'; // Bleu clair
          color = '#850000'; // Bleu foncé
        }
        
  
        return (
          <span style={{ 
            backgroundColor, 
            color,
            fontWeight: 'bold',
            padding: '5px 10px',
            borderRadius: '5px',
            display: 'inline-block'
          }}>
            {text}
          </span>
        );
      },
    },
    { title: 'Client', dataIndex: 'client', key: 'client' },
    { title: 'Montant Estimé', dataIndex: 'totalAmount', key: 'totalAmount' },
    { title: 'Date', dataIndex: 'date', key: 'date' },
    { title: 'Numéro de Devis', dataIndex: 'invoiceNumber', key: 'invoiceNumber' },
    { title: 'Montant Estimé', dataIndex: 'totalAmount', key: 'totalAmount' },
    {
      title: 'Actions',
      key: 'actions',
      render: (_, record) => {
        const menuItems = [
          {
            key: '1',
            label: 'Marquer comme accepté',
            onClick: () => transformToInvoice(record, 'accepté'),
          },
          {
            key: '2',
            label: 'Transformer en facture',
            onClick: () => transformToInvoice(record, 'FACT'),
          },
        ];
        
        return (
             
          <div className="actions">
        
            <Button type="link" icon={<img src={download} className='iconListe' onClick={()=>telechargerFacture(record, 'FACT')} alt="Example" />} /> 
            <Button className='ayeOnMobile' type="link" icon={<img src={eye} className='iconListe' onClick={() => handleModalModeleFactureCancel(record, 'DEVI')} alt="Example" />} /> 
            <Button type="link" icon={<img src={iconEnveloppe} className='iconListe'  onClick={() => handleOpenModal(record, 'DEVI')} alt="Example" />} />  
            {hasPermission('manage_quotes') ? 
                <Button type="link" icon={<img src={edit} className='iconListe'  onClick={() => handleEditInvoice(record, 'DEVI')} alt="Example" />} /> :''
            }  
            {hasPermission('manage_quotes') ? 
                <Button type="link" icon={<img src={trash} className='iconListe'   onClick={() => HandleDeleteFacture(record)} alt="Example" />} />  :''
            }  
  
            {/* Nouveau bouton avec le Dropdown */}
            {hasPermission('manage_quotes')  ? 
              <Dropdown menu={{ items: menuItems }} trigger={['click']}>
                <Button type="link">
                  Plus <DownOutlined />
                </Button>
              </Dropdown>
              :''
            }
        
          </div>
        );
      },
    },
  ];
  return (
 
      <div className="facturation-container">
<Tabs
  defaultActiveKey="dashboard"
  onChange={handleTabChange}
  className="tabs"
  items={
    parametrage.enableQuotes == 1
      ? [
          {
            key: "quotes",
            label: (
              <span style={{ fontWeight: 'bold', fontSize: '18px', color: '#3454d1' }}>
                Gestion des devis
              </span>
            ),
            children: (
              <>
                <div className="filters">
                  {/* Barre de recherche */}
                  <Input.Search
                    placeholder="Rechercher un devis"
                    className="search-bar"
                    onSearch={handleSearch}
                    allowClear
                  />
                  {/* Sélecteur de plage de dates */}
                  <ConfigProvider locale={locale}>
                    <RangePicker className="date-picker" onChange={handleDateChange} />
                  </ConfigProvider>
                  <Select
                    placeholder="Statut"
                    className="statut-filter"
                    onChange={handleStatusChange}
                    value={statusFilter}
                    style={{ width: "250px" }}
                  >
                    <Option value="all">Tous</Option>
                    <Option value="accepté">Accepté</Option>
                    <Option value="en attente">En attente</Option>
                  </Select>
                </div>
                    {hasPermission('manage_quotes') ? 
                      <Button
                        type="primary"
                        onClick={() => handleAddInvoice('DEV')}
                        className="create-button"
                        icon={<PlusOutlined />}
                      >
                        Ajouter un Devis
                      </Button>
                      : ''
                    }
                <div className="tabFacture">
                  <Table
                    pagination={{ pageSize: 8 }}
                    columns={quoteColumns}
                    locale={{ emptyText: 'Aucune donnée à afficher' }}
                    dataSource={
                      filteredInvoices
                        ? filteredInvoices
                            .filter((invoice) => invoice.type === "DEVI")
                            .sort((a, b) => b.id - a.id)
                        : []
                    }
                    rowKey="id"
                    className="invoice-table"
                    rowClassName={(record, index) =>
                      index % 2 === 0 ? 'table-row-even' : 'table-row-odd'
                    }
                  />
                </div>
              </>
            ),
          },
        ]
      : []
  }
/>


        {/* Modale pour Ajouter une Facture */}
        <Modal
          open={modalVisible}
          onOk={handleModalOk}
          onCancel={handleModalCancel}
          okText="Sauvegarder"
          cancelText="Annuler"
          width={window.innerWidth <= 768 ? '100vw' : '55vw'}
          styles={{
            body: {
              height: window.innerWidth <= 768 ? '60vh' : '80vh',
              overflowY: 'auto',
              overflowX: 'hidden',
            },
            mask: {},      // si tu veux styliser le fond sombre
            header: {},    // si tu veux styliser le header
            footer: {},    // idem pour le footer
            content: {},   // contenu global
          }}
          className={modalVisible ? 'modal-slide-in' : ''}
          style={{
            right: 0,
            position: 'fixed',
            top: window.innerWidth <= 768 ? '13%' : '9%',
            margin: 0,
            padding: 0,
          }}
        >

        <div className="containerModalMail">
          <div className="blocenteteEmail">
            <div className="iconMail">
              <img src={facture} alt="Facture ou Devis" />
            </div>
            <div>
              <h1 className='TextTitleModale'>{isInvoice ? 'Votre facture' : 'Votre devis'}</h1>
            </div>
          </div>
          <hr className="hr" />

          <Form form={form} layout="vertical" initialValues={{ date: dayjs() }}>
            {/* Ligne: Numéro de facture et date */}
            <Row gutter={16} className='dateNumFactureModale'>
              <Col span={12}>
                {!isEditingFacture ? 
                  <Form.Item label={isInvoice ? 'Numéro de facture' : 'Numéro de devis'}>
                    <Input value={numeroFacture} disabled />
                  </Form.Item>
                  : 
                  <Form.Item
                    name="invoiceNumber"
                    label={isInvoice ? 'Numéro de facture' : 'Numéro de devis'}
                    rules={[{ required: true, message: 'Veuillez entrer le numéro' }]}
                  >
                    <Input disabled />
                  </Form.Item>
                }
              </Col>
              <Col span={12}>
                <Form.Item 
                  label="Date" 
                  name="date" 
                  rules={[{ required: true, message: 'Veuillez sélectionner une date' }]}
                >
                  <DatePicker 
                    style={{ width: '100%' }} 
                    format="DD/MM/YYYY"
                  />
                </Form.Item>
              </Col>
            </Row>
              
            {/* Client */}
            <Form.Item
              name="client"
              label="Client"
              rules={[{ required: true, message: 'Veuillez sélectionner un client' }]}
            >
              <Select>
                {clientList.map((client) => (
                  <Option key={client.id} value={client.id}>
                    {client.name}
                  </Option>
                ))}
              </Select>
            </Form.Item>
                
            {/* Mode de saisie (TTC ou HT) */}
            <Form.Item
              name="entryMode"
              label="Mode de saisie"
              initialValue={parametrage.enableTTC == 1 ? "TTC" : "HT"}
            >
              <Radio.Group onChange={(e) => setEntryMode(e.target.value)}>
                <Radio value="TTC">TTC</Radio>
                <Radio value="HT">HT</Radio>
              </Radio.Group>
            </Form.Item>

            {/* Taxe secondaire */}
            {tvas.find(tva => tva.taxe_secondaire === 'OUI') && (
              <Form.Item
                label="Taxe secondaire"
              >
                <Radio.Group 
                  value={useTaxeSecondaire ? 'OUI' : 'NON'} 
                  onChange={(e) => setUseTaxeSecondaire(e.target.value === 'OUI')}
                >
                  <Radio value="NON">NON</Radio>
                  <Radio value="OUI">
                    OUI - {tvas.find(tva => tva.taxe_secondaire === 'OUI')?.label} ({tvas.find(tva => tva.taxe_secondaire === 'OUI')?.value}%)
                  </Radio>
                </Radio.Group>
              </Form.Item>
            )}
                
            {/* Produits */}
<Form.Item label="Produits">
  {products.map((product, index) => (
    <Row key={index} gutter={16} style={{ marginBottom: '10px' }} align="middle">
      <Col span={8}>
        <AutoComplete
          options={product.filteredOptions || []}
          style={{ width: '100%' }}
          value={product.productName}
          open={(product.openAutoComplete ?? false) && (product.filteredOptions?.length > 0)}
          onFocus={() => {
            const allOptions = produits.map(p => ({
              label: p.productName,
              value: p.productName,
            }));
            const newProducts = [...products];
            newProducts[index].filteredOptions = allOptions;
            newProducts[index].openAutoComplete = true;
            setProducts(newProducts);
          }}
          onBlur={() => {
            const newProducts = [...products];
            newProducts[index].openAutoComplete = false;
            setProducts(newProducts);
          }}
          onSearch={(searchText) => {
            const filtered = produits
              .filter(p =>
                p.productName.toLowerCase().includes(searchText.toLowerCase())
              )
              .map(p => ({
                label: p.productName,
                value: p.productName,
              }));
            const newProducts = [...products];
            newProducts[index].filteredOptions = filtered;
            newProducts[index].productName = searchText;
            newProducts[index].openAutoComplete = true;
            setProducts(newProducts);
          }}
          onSelect={(value) => {
            const matched = produits.find(p => p.productName === value);
            if (matched) {
              const newProducts = [...products];
              newProducts[index].productName = matched.productName;
                                      newProducts[index].price = entryMode == 'HT' ? parseFloat(matched.priceHT).toFixed(2) : parseFloat(matched.price).toFixed(2); 
                                      newProducts[index].tva = matched.tva;
                                      newProducts[index].id = matched.id;
                                      newProducts[index].openAutoComplete = false;
                                      setProducts(newProducts);
                                    }
                                  }}
                                  placeholder="Nom du produit"
                                  allowClear
                                />
                              </Col>
                                
                              <Col span={3}>
                                <InputNumber
                                  min={1}
                                  value={product.quantity}
                                  onChange={(value) => {
                                    const newProducts = [...products];
                                    newProducts[index].quantity = value || 1;
                                    setProducts(newProducts);
                                  }}
                                />
                              </Col>
                                
                              <Col span={4}>
                                <InputNumber
                                  min={0}
                                  placeholder={`Prix (${entryMode})`}
                                  value={product.price}
                                  onChange={(value) => {
                                    const newProducts = [...products];
                                    newProducts[index].price = value || 0;
                                    setProducts(newProducts);
                                  }}
                                />
                              </Col>
                                
                              <Col span={4}>
                                {tvas.length > 0 && (
                                  <Select
                                    value={
                                      product.tva != null
                                        ? product.tva
                                        : tvas.length > 0
                                        ? tvas[0].value
                                        : undefined
                                    }
                                    onChange={(value) => {
                                      const newProducts = [...products];
                                      newProducts[index].tva = value;
                                      setProducts(newProducts);
                                    }}
                                    placeholder="TVA"
                                    style={{ width: '100%' }}
                                  >
                                    {tvas.map((rate) => (
                                      <Option key={rate.value} value={rate.value}>
                                        {rate.label} {cleanNumber(rate.value)}%
                                      </Option>
                                    ))}
                                  </Select>
                                )}
                              </Col>
                                    
                              <Col span={2}>
                                <Button
                                  type="link"
                                  danger
                                  icon={
                                    <img
                                      src={trash}
                                      alt="supprimer"
                                      style={{ height: '30px' }}
                                    />
                                  }
                                  onClick={() => handleRemoveProduct(index)}
                                />
                              </Col>
                            </Row>
                          ))}
                          {hasPermission('manage_quotes') ?
                              <Button
                                type="dashed"
                                onClick={() =>
                                  setProducts([
                                    ...products,
                                    {
                                      productName: '',
                                      quantity: 1,
                                      price: 0,
                                      tva: tvas.length > 0 ? tvas[0].value : 0,
                                      openAutoComplete: false,
                                      filteredOptions: [],
                                    },
                                  ])
                                }
                                icon={<PlusOutlined />}
                              >
                                Ajouter un produit
                              </Button>
                              : ''
                          }
                        </Form.Item>



                        {/* Total général */}
                        <div className='TotalMdaleDevisFacture'>
                          <div className='blocTotaleModale'>    
                            <div>
                              <div>
                              {parametrage.enableMultipleTVA == 1 && tvas.length > 0 ? (
                                Object.entries(totalTVAByRate).map(([rate, amount]) => (
                                  <div
                                    key={rate}
                                    className="blocTotaleModaleElementCellule blocTotaleModaleElementCelluleTotal"
                                  >
                                    TVA {rate}% : {amount} {devise}
                                  </div>
                                ))
                                ) : tvas.length !== 0 ? (
                                <div className="blocTotaleModaleElementCellule blocTotaleModaleElementCelluleTotal">
                                  TVA : {totalTVA} {devise}
                                </div>
                              ) : null}
                              
                              {/* Affichage de la taxe secondaire si elle existe */}
                              {taxeSecondaire && totalTPS > 0 && (
                                <div className="blocTotaleModaleElementCellule blocTotaleModaleElementCelluleTotal">
                                  {taxeSecondaire.label} {taxeSecondaire.value}% : {totalTPS} {devise}
                                </div>
                              )}
                              </div>
                            <p className='blocTotaleModaleElementCellule blocTotaleModaleElementCelluleTotal'><strong> HT :</strong> {totalHT} {devise}</p>
                            <p className='blocTotaleModaleElementCellule blocTotaleModaleElementCelluleTotal'><strong>TTC :</strong> {totalTTC} {devise}</p>
                          </div>
                          </div>
            </div>
          </Form>
        </div>


        </Modal>
        <Modal
          open={modalFactureVisible}
          onOk={handleModeleFactureImpression}
          onCancel={handleModalModeleFactureCancel}
          okText="Télécharger"
          cancelText="Annuler"
          width={window.innerWidth <= 768 ? '100vw' : '55vw'} 
          styles={{
            body: {
              height: window.innerWidth <= 768 ? '60vh' : '80vh',
              overflowY: 'auto',
              overflowX: 'hidden',
            },
            mask: {},      // si tu veux styliser le fond sombre
            header: {},    // si tu veux styliser le header
            footer: {},    // idem pour le footer
            content: {},   // contenu global
          }}
          className={modalFactureVisible ? 'modal-slide-in' : ''}
          style={{
            right: 0,
            position: 'fixed',
            top: window.innerWidth <= 768 ? '13%' : '9%', 
            margin: 0,
            padding: 0,
          }} 
        >
            <div ref={factureRef} className='divModalModeleFacture'>
              <ModeleFacture factures={factures} parametrage={parametrage} tvas={tvas}  type={isInvoice ? 'FACT' : 'DEVI'}/>
            </div>
        </Modal>
        
        <Modal
          okText="Envoyer"
          open={modalMailVisible}
          width={window.innerWidth <= 768 ? '100vw' : '55vw'} // Largeur à 50% de la fenêtre
          styles={{
            body: {
              height: window.innerWidth <= 768 ? '60vh' : '80vh',
              overflowY: 'auto',
              overflowX: 'hidden',
            },
            mask: {},      // si tu veux styliser le fond sombre
            header: {},    // si tu veux styliser le header
            footer: {},    // idem pour le footer
            content: {},   // contenu global
          }}
          className={modalMailVisible ? 'modal-slide-in' : ''}
          style={{
            right: 0, // Toujours collé à droite
            position: 'fixed',
            top: window.innerWidth <= 768 ? '13%' : '9%', // Ajustez la position verticale si nécessaire
            margin: 0,
            padding: 0,
          }}
          onOk={handleSendFacture} // Assurez-vous que cette fonction existe
          onCancel={() => setModalMailVisible(false)}
        >     
          <div className='containerModalMail'> 
            <div className='blocenteteEmail'>
                <div className='iconMail'>
                  <img src={iconEnveloppe} alt="Example" />
                </div>
                <div>
                  <h1>Envoyer un email</h1>
                </div>
 
            </div>
            <hr className='hr' />
            <div className="form-container">
              <Form layout="vertical">
                <Form.Item label="Client">
                  <Input value={emailData.clientName} readOnly className="fixed-height-input" />
                </Form.Item>
                <Form.Item label="Objet">
                  <Input value={emailData.emailSubject} readOnly className="fixed-height-input" />
                </Form.Item>
                <Form.Item label="Message">
                  <Input.TextArea
                    value={emailData.emailBody}
                    rows={8} 
                    
                    className="dynamic-height-textarea"
                  />
                </Form.Item>
                {pdfAttachment && (
                  <Form.Item
                    label={emailData.type === 'FACT' ? 'Télécharger la Facture' : 'Télécharger le Devis'}
                  >
                    <a
                      href={URL.createObjectURL(pdfAttachment)}
                      download={`facture-${emailData.clientName}.pdf`}
                      className="download-link"
                    >
                      Télécharger la pièce jointe
                    </a>
                  </Form.Item>
                )}
              </Form>
            </div>
          </div>
        </Modal>
        <Modal
          open={modaleFacturePayeVisible}
          onOk={() => {
            formRef.current?.submit()
            obtenirFactures();
          }}
          onCancel={transformToInvoiceCancel}
          okText="Valider"
          cancelText="Annuler"
          width={window.innerWidth <= 768 ? '100vw' : '55vw'}  // Largeur à 50% de la fenêtre
          styles={{
            body: {
              height: window.innerWidth <= 768 ? '60vh' : '80vh',
              overflowY: 'auto',
              overflowX: 'hidden',
            },
            mask: {},      // si tu veux styliser le fond sombre
            header: {},    // si tu veux styliser le header
            footer: {},    // idem pour le footer
            content: {},   // contenu global
          }}
          className={modaleFacturePayeVisible ? 'modal-slide-in' : ''}
          style={{
            right: 0, // Toujours collé à droite
            position: 'fixed',
            top: window.innerWidth <= 768 ? '13%' : '9%',  // Ajustez la position verticale si nécessaire
            margin: 0,
            padding: 0,
          }}  
        >
            <div ref={factureRef} className='divModalModeleFacture'>
            <ModaleMarqueCom factures={facturePaye} onSave={handleSaveFacture} formRef={formRef} devise={devise}/>
            </div>
        </Modal>

      </div>
 
  );
};

export default DevisPage;
